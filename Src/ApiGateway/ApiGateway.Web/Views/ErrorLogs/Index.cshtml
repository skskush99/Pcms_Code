<h2 style="text-align:center" >Application Logs</h2>

<br />
<div>
    @Html.Label("selectOption", "Please select Service Name")
   
    <br />
    @*@Html.DropDownList("selectOption", (SelectList)ViewBag.DropdownList, "Select a Service", new {@class="btn btn-secondary btn-sm dropdown-toggle"})*@
    @Html.DropDownList("selectFolderPath", (SelectList)ViewBag.items, new {@class="btn btn-secondary btn-sm dropdown-toggle"})
    &nbsp;
    <button class="btn btn-primary btn-sm" id="showButton">Show</button>
</div>
<br />
<div id="ErrorLogTableDiv">
    <!-- HTML content from the action method will be displayed here -->
</div>


<script>
    $("#showButton").click(function () {
        debugger;
        var selectedOption = $("#selectFolderPath :selected").text();
        var folderPath = $("#selectFolderPath").val();
        $.ajax({
            url: '@Url.Action("GetErrorLogFiles", "ErrorLogs")',
            data: { ServiceName: selectedOption, folderPath: folderPath },
            success: function (data) {
            $("#ErrorLogTableDiv").html(data);
            }
        });
    });
</script>

