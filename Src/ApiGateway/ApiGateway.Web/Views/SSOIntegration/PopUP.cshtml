<script>
    window.onload =function() 
    {      
        $("#MyPopup").modal("show");      
    }
    $(document).ready(function (){
        $("#BackToSSO").click(function () {
                    var url = '@Url.Action("BackToSSO", "SSOIntegration")';
            window.location = url;
        });
    });
   
</script>

