@model Core.Models.User.SSOTokenDetails
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sampark</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <style>
        .dept-container {
        }

            .dept-container .card {
                position: relative;
                display: flex;
                flex-direction: column;
                min-width: 0;
                height: var(--bs-card-height);
                word-wrap: break-word;
                background-color: #fff;
                background-clip: border-box;
                border: 1px solid rgba(0, 0, 0, 0.175);
                border-radius: 0.375rem;
                height: 185px;
                margin-top: 20px;
            }

                .dept-container .card a:hover
                {
                text-decoration:none;
                }

                .dept-container .card:hover {
                    box-shadow: 0px 0px 10px 0px rgb(119 115 115 / 50%);
                    transition: background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s;
                }

                .dept-container .card h3 {
                    font-size: 16px;
                    font-weight: bold;
                    color: #495057;
                    text-align: center;
                    padding: 0px 20px 0px 20px;
                    line-height: 24px;
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                
                }

                .dept-container .card img {
                    width: 70px;
                    height: 70px;
                    margin: auto;
                }

        .img-icon {
            float: left;
            width: 100%;
            text-align: center;
            margin-top: 30px;
            margin-bottom: 15px;
        }

        .site-heading {
            color: #FFF;
            margin-left: 1rem;
            font-size: 28px !important;
            font-weight: bold;
        }

        .dashboard-header-dept {
            background: #405189;
            padding: 10px 10px 10px 10px;
            margin-bottom: 30px;
        }

            .dashboard-header-dept button {
                float: right;
                position: absolute;
                right: 10px;
                top: 15px;
                background: #fff;
                border-radius: 5px;
                border: 0;
            }

            .dashboard-header-dept h1 {
                margin: 0px;
            }

    </style>
    <script>
        $(document).ready(function () 
        {           
            $("#backtosso").click(function () {
                // var otp = $("#otpValue").text();
                var url = '@Url.Action("BackToSSO", "SSOIntegration")';
                window.location = url;
            })

           
        });
    </script>
    <script>
        
        //window.onload = function ()
        //{
        //    debugger;
        //    //document.forms['myFormSsoDetail'].submit();
        //}
    </script>
</head>
<body>
    <div class="dashboard-header-dept">

        <h1 class="site-heading">RajSampark</h1>
        <button type="button" id="backtosso" name="backtosso" value="backtosso">Back To SSO</button>
    </div>

    <div class="container">
        <div class="row dept-container">     
            @if (Model != null)
            {
                <div class="col-sm-3">
                    <div class="card">
                        <a  title="Login" href="@Url.Action("SsoDetail", "SSOIntegration", new{sAMAccountName = Model.sAMAccountName, ssotoken = Model.SsoToken,UserType=Model.UserType,roles=Model.Roles,OldSSOIDs=Model.OldSSOIDs})">
                            <div class="img-icon"> <img src="data:image/png;base64" /></div>
                            <h3>Login</h3>
                        </a>
                    </div>
                </div>
                @*using (Html.BeginForm(null, null, FormMethod.Post, new
                {
                    @action = "/SSOIntegration/SsoDetail"+"?sAMAccountName="+Model.sAMAccountName+"&ssotoken="+Model.SsoToken+"&UserType="+Model.UserType+"&roles="+Model.Roles,
            id = "myFormSsoDetail"
                })) ;*@

            }
            
        </div>
    </div>
</body>
</html>